# Copy to .env and fill in. Nothing here is a real secret.

# "development" allows http cookies on localhost. Anything else = production.
APP_ENV=development

# Development only: "true" lets the "Verify your email" step accept any 6 digits. Ignored unless APP_ENV=development.
DEV_ACCEPT_ANY_CODE=false

# The same MySQL server and "Ai" database the task management Design module uses.
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
AI_DB_NAME=Ai

# Signs the login cookie. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Where the portal frontend runs: used in email links and for CORS.
FRONTEND_URL=http://localhost:3100

# Images. "gcs" = the shared "advart" bucket, signed in with key/auth.py (the studio's service account, see README);
# "local" = files on disk, for development without the bucket.
STORAGE_BACKEND=gcs
GCS_BUCKET=advart
LOCAL_STORAGE_DIR=local_storage

# Email (verification codes, reset links, team invitations), e.g. a Gmail account with an app password.
# Left empty in development = printed to the console instead of sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Advart Gen <you@example.com>"

# "Continue with Google". Empty = the button says it is not set up.
GOOGLE_CLIENT_ID=

# Online payment (Razorpay). Not used by the page any more ("Pay now" sends a screenshot); leave empty.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# An invoice is due this many days after its date unless a due date is set.
INVOICE_DUE_DAYS=15
